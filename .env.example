# Copy to .env and fill in from your Supabase project (Settings → API,
# or Settings → General → "Reference ID" if the URL isn't shown directly:
# it's https://<reference-id>.supabase.co).
# EXPO_PUBLIC_* vars are inlined into the app bundle at build time.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only (never shipped). Used by scripts/ to seed content. Do NOT prefix with EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Visit Seoul API Center (Seoul Tourism Organization) — PRIMARY content source
# (English-native + linked Korean names, better tourist-facing quality than
# TourAPI). Sign up at https://api.visitseoul.net → 마이페이지 → API 키 관리.
# Used only by scripts/import-visitseoul.ts.
VISITSEOUL_API_KEY=

# TourAPI 4.0 (Korea Tourism Organization) — supplementary content source,
# used only by scripts/import-tourapi.ts. Korean-only (see that file's header
# for why English enrichment from TourAPI was abandoned).
# Apply at https://www.data.go.kr (search "한국관광공사" → apply for the API named below).
# Required: 한국관광공사_국문 관광정보 서비스_GW
TOURAPI_SERVICE_KEY=
# Optional (for English names/descriptions): 한국관광공사_영문 관광정보서비스_GW
# Leave blank to reuse TOURAPI_SERVICE_KEY once that's also approved.
TOURAPI_ENG_SERVICE_KEY=

# Naver Maps JavaScript SDK v3 Client ID (the "ncpKeyId"), used by
# components/WebMap.tsx (loaded inside a WebView — see docs/OPERATIONS.md).
# NCP Console → Services → Application Services → Maps → Application →
# register a "Web Dynamic Map" app (NOT Mobile — that tier has no free quota)
# with a Service URL, then copy its Client ID here. Public/client-exposed by
# design (Naver secures it via domain whitelisting, not secrecy) — leave
# blank to keep the stylized SVG fallback map.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# Naver Open API — Search (a separate, free product from the Maps SDK above;
# different console, different keys). Used only by
# scripts/backfill-place-website.ts to resolve each place's own official
# website, once, for the "Visit website" link on the place detail screen (see
# migration-025 — NOT a review source; Naver has no official API for that).
# Register at https://developers.naver.com/apps → 애플리케이션 등록 → check "검색"
# (Search) API, then copy the app's Client ID/Secret here. Server-only — do
# NOT prefix with EXPO_PUBLIC_.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# NAVER Cloud Platform Static Map API — powers the real-map route-preview
# images on Feed route cards (supabase/functions/static-map). The SAME "Maps"
# Application that issued EXPO_PUBLIC_NAVER_MAP_CLIENT_ID above also has a
# Secret Key (NCP Console → AI·NAVER API → Application → that Maps app →
# Secret Key field) — it's a different auth style (ID-KEY headers) from the
# JS SDK's client-id-only/domain-whitelist auth, so fetch it separately even
# though the Client ID value is the same. Server-only (Edge Function secret,
# set via `supabase secrets set`) — do NOT prefix with EXPO_PUBLIC_.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Supabase CLI personal access token — only needed to deploy Edge Functions
# or query projects from the command line. Not used by the app.
# https://supabase.com/dashboard/account/tokens
#
# Why here rather than `supabase login`: that stores the token in the macOS
# keychain, whose unlock prompt cannot be answered from a non-interactive
# shell — so login reports success in a human terminal and every scripted
# call still gets 401.
#   export SUPABASE_ACCESS_TOKEN=$(grep -m1 ^SUPABASE_ACCESS_TOKEN .env | cut -d= -f2-)
SUPABASE_ACCESS_TOKEN=sbp_xxx
